{
  "name": "openflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenFlow — the open-source, 100% offline voice OS for intelligent dictation and zero-shot voice cloning.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "engine": "python3 -m engine.server",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:py": "python3 -m unittest discover -s tests -t .",
    "test": "npm run typecheck && npm run test:py",
    "tauri": "tauri"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "voice-cloning",
    "tts",
    "offline",
    "whisper",
    "kokoro",
    "tauri"
  ],
  "author": "OpenFlow Contributors",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
